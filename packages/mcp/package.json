{
  "name": "@sixty/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "sixty-mcp": "./src/stdio.ts"
  },
