  "guides": {
    "1": {
      "text": "♠A-K-Q-J-10 五连！**同分比花色**——40♠ 压过 40♥。",
      "why": "♠ 五连里 ♠10 自带 10 分，攻守都在你手上。"
    },
    "4": {
      "text": "♠ 够硬，跟到 45♠——花色序最上头。"
    },
    "7": {
      "text": "压过所有 50 只有一招：**抬分数**——55♠。"
    },
    "10": {
      "text": "他叫 60 就得抓 60——你捏 ♠、小满捏 ♦，他凑不齐。**让给他打**。"
    },
    "14": {
      "text": "♥A 赢不了——跟最小的 ♥6，连牌 **♥8-7 别拆**。"
    },
    "17": {
      "text": "跟两张：♥8-7 挨着就**整段交**——这叫结构优先。"
    },
    "20": {
      "text": "♦10-8-4 互不相邻，全交——同伴 ♦A-K-Q 管赢，10 分进**闲家**的账。"
    },
    "22": {
      "text": "♠A-K **直接压过**——10 分进账，顺带榨干他的 ♠。"
    },
    "24": {
      "text": "♠Q-J-10 三连甩出去，25 分**逼他用主牌杀**。"
    },
    "29": {
      "text": "同伴 ♣10 已管赢——跟最小的 ♣2，♣9 留着。"
    },
    "31": {
      "text": "♣A 争不过，跟 ♣7。记一笔：♣3-♦3 二连是**负担**——对面领两张主牌就整条抽走。"
    },
    "35": {
      "text": "双王来了，必须跟两张主牌——♣3-♦3 整条被抽走，这就是刚才那笔账。"
    },
    "38": {
      "text": "**缺门杀牌**：♦ 早空了，♣9 杀下去——10 分进账。"
    },
    "39": {
      "text": "末轮定底牌归属——级牌也算主牌，看结局。"
    }
  },
  "notes": {
    "0": "小满开 40♥。",
    "2": "阿凯插叫 45♣。",
    "3": "小满跟到 45♥。",
    "5": "阿凯顶到 50♣。",
    "6": "小满跟到 50♥。",
    "8": "60♣！及格线抬上去了。",
    "9": "小满放手。",
    "12": "♥A 领出，谁也大不过。",
    "13": "小满跟 ♥2。",
    "15": "阿凯接着甩 ♥Q-J 二连。",
    "16": "♥10-9 跟上，10 分搭进去。",
    "18": "阿凯换 ♦7-6-5 三连。",
    "19": "小满的 ♦A-K-Q 整条压过！",
    "21": "小满抢到领出，攻 ♠9-8。",
    "23": "阿凯的 ♠ 只剩两张小牌。",
    "25": "阿凯没有 ♠ 了——用主牌 ♣K-Q-J 杀！",
    "26": "小满垫 ♥4、♠5、♦2——♠ 只剩这一张，不垫不行。",
    "27": "阿凯吊 ♣8。",
    "28": "小满的 ♣10 收下，10 分。",
    "30": "小满继续攻 ♣4。",
    "32": "阿凯的 ♣A 收。",
    "33": "阿凯双王连出，没人压得住。",
    "34": "小满跟 ♥3、♣6。",
    "36": "阿凯领 ♦J。",
    "37": "小满垫 ♥K——10 分进你们这轮。",
    "40": "阿凯用 ♣5 杀末轮……",
    "41": "但小满的 ♠3 是级牌！压过普通主牌，末轮归闲家——抠底。"
  },
  "review": {
    "intro": "这副的三个看点：叫牌时的**让**、跟牌时的**结构**、还有最后那张**级牌**。",
    "tricks": {
      "0": "垫最小 ♥6，连牌 ♥8-7 留给下轮。",
      "1": "跟两张：♥8-7 整段交出。",
      "2": "♦ 单牌全交；同伴 ♦A-K-Q 管赢，10 分进闲家。",
      "3": "♠A-K 压过，10 分进闲家。",
      "4": "♠Q-J-10 逼他用三张主牌杀——主牌见底。",
      "5": "同伴 ♣10 已管赢，跟最小 ♣2。",
      "6": "♣3-♦3 二连是**负担**：对面领两张主牌就被整条抽走。",
      "7": "双王一到，二连果然整条被抽走——想留 ♣3 只能提前单出 ♦3。",
      "8": "**缺门杀牌**：♣9 杀掉这一轮，10 分进闲家。",
      "9": "末轮 ♠3 是级牌、压过 ♣5——**抠底**，底分从阿凯账上扣。"
    },
    "outro": "叫 60 只抓 35——差 30，你俩各升 3 级。那个「不叫」值三级。"
  },
